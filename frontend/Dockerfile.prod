# Front de production : build Vite servi par nginx, qui relaie /api et /ws au backend.
# Node 20+ : exigé par react-router 7
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY ./src ./src
COPY index.html vite.config.js ./
# vite.config.js exige cette variable même pour un build (elle ne sert qu'au serveur de dev)
RUN VITE_BACKEND_ORIGIN=unused npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
